IUCN_REDLIST_API_TOKEN=

# Required - Get from https://api.speciesplus.net/ (free for research)
SPECIESPLUS_API_TOKEN=

# Optional - Google Translate API key (paid, more reliable)
# GOOGLE_TRANSLATE_API_KEY=

# Optional - LibreTranslate self-hosted URL
# LIBRETRANSLATE_URL=http://localhost:5000